# ── Servidor ────────────────────────────────────────────
PORT=3000

# ── Seguridad ───────────────────────────────────────────
JWT_SECRET=cambia-esto-por-algo-muy-secreto-en-produccion
SESSION_SECRET=otro-secreto-para-las-sesiones

# ── Google OAuth ────────────────────────────────────────
# 1. Ve a https://console.cloud.google.com
# 2. Crea un proyecto → APIs y Servicios → Credenciales → OAuth 2.0
# 3. Agrega como URI de redireccionamiento autorizado:
#    http://localhost:3000/api/auth/google/callback
# 4. Copia el Client ID y Client Secret aquí:
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ── Frontend ────────────────────────────────────────────
# Dirección donde corre el frontend (para redirigir después del login con Google)
FRONTEND_URL=http://localhost:5500

# ── Dominio institucional ───────────────────────────────
DOMINIO_CORREO=@amigo.edu.co

# ── Reglas de Negocio ───────────────────────────────────
RN_PROMEDIO_MINIMO=3.0
RN_HORAS_CANCELACION=24
RN_MAX_ESTUDIANTES_POR_TUTOR=15

# ── Agenda de Tutorías (módulo hexagonal) ───────────────
RN_HORAS_ANTICIPACION_MIN=2      # RN-02: anticipación mínima para programar
RN_HORAS_CANCELACION_DOCENTE=12  # RN-03: plazo del docente (RN_HORAS_CANCELACION = plazo del estudiante)
